generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TermStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MemberRole {
  STUDENT
  TA
  TEACHER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum GroupRecruitmentMode {
  COURSE
  INVITE
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum SubmissionReviewStatus {
  PENDING
  COMPLETED
  LEGACY_UNKNOWN
}

enum Visibility {
  PUBLIC
  OFFERING
}

enum PostType {
  NEWS
  PROJECT
}

enum GradeStatus {
  DRAFT
  PUBLISHED
}

enum AssignmentMode {
  INDIVIDUAL
  GROUP
}

enum TeachingRecordKind {
  OBSERVATION
  PARTICIPATION
  LEAVE_REPORTED
  LEAVE_CONFIRMED
  TEACHING_JUDGMENT
  ABSENT
}

enum TeachingObservationChange {
  CORRECTED
  WITHDRAWN
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  name        String
  isAdmin     Boolean        @default(false)
  isDemo      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  staff       CourseStaff[]
  memberships CourseMember[]
  sessions    AuthSession[]
  posts       Post[]
  files       FileObject[]
  createdAssignments Assignment[] @relation("AssignmentCreator")
  createdResources Resource[] @relation("ResourceCreator")
  assignmentRevisions AssignmentRevision[]
  groupPageRevisions GroupPageRevision[]
  correctionEvents SubmissionCorrectionEvent[]
  teachingObservations TeachingObservation[]
  teachingObservationRevisions TeachingObservationRevision[]
  teachingFeedback TeachingFeedback[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Course {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String           @default("")
  staff       CourseStaff[]
  offerings   CourseOffering[]
}

model CourseStaff {
  courseId String
  userId   String
  role     MemberRole @default(TEACHER)
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([courseId, userId])
}

model Term {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  status    TermStatus       @default(DRAFT)
  startDate DateTime
  endDate   DateTime
  offerings CourseOffering[]
}

model CourseOffering {
  id          String         @id @default(cuid())
  courseId    String
  termId      String
  title       String
  description String         @default("")
  status      TermStatus     @default(DRAFT)
  groupFormationWindowId String?
  groupFormationClosesAt DateTime?
  groupFormationCapacity Int?
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  term        Term           @relation(fields: [termId], references: [id], onDelete: Restrict)
  members     CourseMember[]
  groups      Group[]
  assignments Assignment[]
  resources   Resource[]
  posts       Post[]
  notes       TeachingNote[]
  focus       CourseFocus?
  subpages    CourseSubpage[]

  files FileObject[]
  observations TeachingObservation[]
  feedback TeachingFeedback[]

  @@unique([courseId, termId])
}

model CourseMember {
  id               String                  @id @default(cuid())
  offeringId       String
  userId           String
  role             MemberRole
  status           MemberStatus            @default(ACTIVE)
  joinedAt         DateTime                @default(now())
  offering         CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  groupMemberships GroupMember[]
  taAssignments    TaGroupAssignment[]
  submissions      Submission[]
  participants     SubmissionParticipant[]
  reviews          Review[]
  updatedReviewStates SubmissionVersionReview[] @relation("ReviewStateUpdater")
  reviewStateEvents SubmissionReviewEvent[] @relation("ReviewEventActor")
  grades           GradeRecord[]

  uploadedVersions SubmissionVersion[] @relation("SubmittedBy")
  updatedGrades    GradeRecord[]       @relation("GradeUpdater")
  gradeChanges     GradeHistory[]
  notes            TeachingNote[]
  observations TeachingObservation[]
  feedback TeachingFeedback[]
  feedbackReceipts TeachingFeedbackRecipient[]

  @@unique([offeringId, userId])
  @@unique([id, offeringId])
  @@index([offeringId, role, status])
}

model Group {
  id            String              @id @default(cuid())
  offeringId    String
  name          String
  description   String              @default("")
  recruitmentMode     GroupRecruitmentMode?
  recruitmentWindowId String?
  recruitmentToken    String? @unique
  recruitmentNote     String  @default("")
  offering      CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  members       GroupMember[]
  taAssignments TaGroupAssignment[]
  submissions   Submission[]
  page          GroupPage?
  observations TeachingObservation[] @relation("ObservationTargetGroup")
  observationContexts TeachingObservation[] @relation("ObservationContextGroup")
  feedback TeachingFeedback[]

  @@unique([offeringId, name])
  @@unique([id, offeringId])
}

model GroupMember {
  id             String       @id @default(cuid())
  offeringId     String
  groupId        String
  courseMemberId String
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  group          Group        @relation(fields: [groupId, offeringId], references: [id, offeringId], onDelete: Restrict)
  courseMember   CourseMember @relation(fields: [courseMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@index([groupId, leftAt])
  @@index([courseMemberId, joinedAt])
}

model TaGroupAssignment {
  id             String       @id @default(cuid())
  offeringId     String
  groupId        String
  courseMemberId String
  assignedAt     DateTime     @default(now())
  endedAt        DateTime?
  group          Group        @relation(fields: [groupId, offeringId], references: [id, offeringId], onDelete: Restrict)
  courseMember   CourseMember @relation(fields: [courseMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@index([courseMemberId, endedAt])
}

model Assignment {
  id          String         @id @default(cuid())
  offeringId  String
  title       String
  description String         @default("")
  mode        AssignmentMode
  status      AssignmentStatus @default(DRAFT)
  dueAt       DateTime?
  maxScore    Decimal        @default(100) @db.Decimal(8, 2)
  revision    Int            @default(1)
  cancellationReason String?
  creationRequestId String? @unique
  creationFingerprint String?
  creatorId String?
  creator User? @relation("AssignmentCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  submissions Submission[]
  grades      GradeRecord[]
  focusLinks  CourseFocusAssignment[]
  revisions AssignmentRevision[]

  @@unique([id, offeringId])
  @@index([offeringId, status])
}

model AssignmentRevision {
  id String @id @default(cuid())
  assignmentId String
  offeringId String
  revision Int
  title String
  description String
  mode AssignmentMode
  dueAt DateTime?
  maxScore Decimal @db.Decimal(8, 2)
  status AssignmentStatus
  cancellationReason String?
  actorUserId String?
  createdAt DateTime @default(now())
  isBaseline Boolean @default(false)
  assignment Assignment @relation(fields: [assignmentId, offeringId], references: [id, offeringId], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  submissions SubmissionVersion[]

  @@unique([assignmentId, revision])
  @@unique([id, offeringId])
  @@index([assignmentId, createdAt])
}

model Submission {
  id             String              @id @default(cuid())
  offeringId     String
  assignmentId   String
  courseMemberId String?
  groupId        String?
  assignment     Assignment          @relation(fields: [assignmentId, offeringId], references: [id, offeringId], onDelete: Restrict)
  courseMember   CourseMember?       @relation(fields: [courseMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)
  group          Group?              @relation(fields: [groupId, offeringId], references: [id, offeringId], onDelete: Restrict)
  versions       SubmissionVersion[]
  correctionUntil DateTime?
  correctionRevision Int @default(0)
  correctionEvents SubmissionCorrectionEvent[]

  @@unique([id, offeringId])
  @@unique([assignmentId, courseMemberId])
  @@unique([assignmentId, groupId])
}

model SubmissionVersion {
  id           String                  @id @default(cuid())
  offeringId   String
  submissionId String
  version      Int
  body         String
  submittedAt  DateTime                @default(now())
  requestFingerprint String?
  assignmentRevisionId String?
  assignmentRevision AssignmentRevision? @relation(fields: [assignmentRevisionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  submission   Submission              @relation(fields: [submissionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  participants SubmissionParticipant[]
  files        SubmissionFile[]
  reviews      Review[]
  reviewState SubmissionVersionReview?
  observations TeachingObservation[]
  feedback TeachingFeedback[]

  submittedById String
  finalizedAt   DateTime?
  submittedBy   CourseMember @relation("SubmittedBy", fields: [submittedById, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@unique([submissionId, version])
  @@unique([id, offeringId])
}

model SubmissionParticipant {
  offeringId     String
  versionId      String
  courseMemberId String
  version        SubmissionVersion @relation(fields: [versionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  courseMember   CourseMember      @relation(fields: [courseMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@id([versionId, courseMemberId])
}

model Review {
  id         String            @id @default(cuid())
  offeringId String
  versionId  String
  reviewerId String
  body       String
  score      Decimal?          @db.Decimal(8, 2)
  createdAt  DateTime          @default(now())
  version    SubmissionVersion @relation(fields: [versionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  reviewer   CourseMember      @relation(fields: [reviewerId, offeringId], references: [id, offeringId], onDelete: Restrict)

  grades GradeRecord[]

  @@unique([id, offeringId])
  @@index([versionId, createdAt])
}

model SubmissionVersionReview {
  versionId String @id
  offeringId String
  state SubmissionReviewStatus @default(PENDING)
  revision Int @default(1)
  updatedById String?
  updatedAt DateTime @default(now()) @updatedAt
  version SubmissionVersion @relation(fields: [versionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  updatedBy CourseMember? @relation("ReviewStateUpdater", fields: [updatedById, offeringId], references: [id, offeringId], onDelete: Restrict)
  history SubmissionReviewEvent[]

  @@unique([versionId, offeringId])
}

model SubmissionReviewEvent {
  id String @id @default(cuid())
  versionId String
  offeringId String
  revision Int
  state SubmissionReviewStatus
  actorId String?
  createdAt DateTime @default(now())
  isBaseline Boolean @default(false)
  review SubmissionVersionReview @relation(fields: [versionId, offeringId], references: [versionId, offeringId], onDelete: Restrict)
  actor CourseMember? @relation("ReviewEventActor", fields: [actorId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@unique([versionId, revision])
  @@index([versionId, createdAt])
}

model GradeRecord {
  id             String         @id @default(cuid())
  offeringId     String
  assignmentId   String
  courseMemberId String
  score          Decimal        @db.Decimal(8, 2)
  status         GradeStatus    @default(DRAFT)
  publishedAt    DateTime?
  reviewId       String
  updatedById    String
  updatedAt      DateTime       @updatedAt
  assignment     Assignment     @relation(fields: [assignmentId, offeringId], references: [id, offeringId], onDelete: Restrict)
  courseMember   CourseMember   @relation(fields: [courseMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)
  review         Review         @relation(fields: [reviewId, offeringId], references: [id, offeringId], onDelete: Restrict)
  updatedBy      CourseMember   @relation("GradeUpdater", fields: [updatedById, offeringId], references: [id, offeringId], onDelete: Restrict)
  history        GradeHistory[]

  @@unique([assignmentId, courseMemberId])
  @@unique([id, offeringId])
}

model GradeHistory {
  id            String       @id @default(cuid())
  offeringId    String
  gradeRecordId String
  actorId       String
  previousScore Decimal?     @db.Decimal(8, 2)
  score         Decimal      @db.Decimal(8, 2)
  status        GradeStatus
  reason        String
  recordedAt    DateTime     @default(now())
  gradeRecord   GradeRecord  @relation(fields: [gradeRecordId, offeringId], references: [id, offeringId], onDelete: Restrict)
  actor         CourseMember @relation(fields: [actorId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@index([gradeRecordId, recordedAt])
}

model FileObject {
  offeringId   String
  offering     CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  id           String           @id @default(cuid())
  ownerId      String
  storageKey   String           @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  bytes        Bytes?
  createdAt    DateTime         @default(now())
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  submissions  SubmissionFile[]

  @@unique([id, offeringId])
}

model SubmissionFile {
  offeringId String
  versionId  String
  fileId     String
  version    SubmissionVersion @relation(fields: [versionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  file       FileObject        @relation(fields: [fileId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@id([versionId, fileId])
}

model Resource {
  id         String         @id @default(cuid())
  offeringId String
  title      String
  body       String
  url        String?
  status     ContentStatus  @default(DRAFT)
  revision Int @default(1)
  firstPublishedAt DateTime?
  creationRequestId String? @unique
  creationFingerprint String?
  creatorId String?
  creator User? @relation("ResourceCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  visibility Visibility     @default(OFFERING)
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  focusLinks CourseFocusResource[]
  file       ResourceFile?

  @@unique([id, offeringId])
  @@index([offeringId, status])
}

model ResourceFile {
  resourceId String   @id
  name       String
  size       Int
  bytes      Bytes
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model CourseFocus {
  offeringId  String                  @id
  title       String
  body        String                  @default("")
  document    Json?
  draftDocument Json?
  draftTitle String?
  draftSavedAt DateTime?
  publishedAt DateTime?
  revision    Int                     @default(0)
  updatedAt   DateTime                @updatedAt
  offering    CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  assignments CourseFocusAssignment[]
  resources   CourseFocusResource[]
}

model CourseSubpage {
  id                 String         @id
  offeringId         String
  creationFingerprint String
  title              String         @default("")
  document           Json
  publishedAt        DateTime?
  draftTitle         String?
  draftDocument      Json?
  draftSavedAt       DateTime?
  revision           Int            @default(1)
  createdAt          DateTime       @default(now())
  offering           CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  teachingObservations TeachingObservation[]

  @@unique([id, offeringId])
  @@index([offeringId, createdAt, id])
}

model CourseFocusAssignment {
  offeringId   String
  assignmentId String
  focus        CourseFocus @relation(fields: [offeringId], references: [offeringId], onDelete: Cascade)
  assignment   Assignment  @relation(fields: [assignmentId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@id([offeringId, assignmentId])
}

model CourseFocusResource {
  offeringId String
  resourceId String
  focus      CourseFocus @relation(fields: [offeringId], references: [offeringId], onDelete: Cascade)
  resource   Resource    @relation(fields: [resourceId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@id([offeringId, resourceId])
}

model Post {
  id          String          @id @default(cuid())
  offeringId  String?
  authorId    String
  title       String
  slug        String          @unique
  coverLabel  String          @default("示例内容")
  excerpt     String          @default("")
  body        String
  type        PostType
  status      ContentStatus   @default(DRAFT)
  visibility  Visibility      @default(OFFERING)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  offering    CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  author      User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, visibility, publishedAt])
  @@index([offeringId, type])
}

model GroupPage {
  id         String        @id @default(cuid())
  offeringId String
  groupId    String        @unique
  title      String
  body       String
  status     ContentStatus @default(DRAFT)
  visibility Visibility    @default(OFFERING)
  revision Int @default(1)
  updatedAt DateTime @default(now()) @updatedAt
  revisions GroupPageRevision[]
  group      Group         @relation(fields: [groupId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@unique([groupId, offeringId])
}

model TeachingNote {
  courseMemberId String
  author         CourseMember   @relation(fields: [courseMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)
  id             String         @id @default(cuid())
  offeringId     String
  title          String
  body           String
  createdAt      DateTime       @default(now())
  offering       CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
}


model GroupPageRevision {
  id String @id @default(cuid())
  offeringId String
  groupId String
  revision Int
  title String
  body String
  actorUserId String?
  createdAt DateTime @default(now())
  isBaseline Boolean @default(false)
  page GroupPage @relation(fields: [groupId, offeringId], references: [groupId, offeringId], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([groupId, revision])
  @@index([groupId, createdAt])
}

model SubmissionCorrectionEvent {
  id String @id @default(cuid())
  offeringId String
  submissionId String
  revision Int
  until DateTime?
  actorUserId String
  createdAt DateTime @default(now())
  submission Submission @relation(fields: [submissionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([submissionId, revision])
}

model TeachingObservation {
  id String @id @default(cuid())
  offeringId String
  authorUserId String
  /// A whole-lesson observation has a page and neither a student nor a group target.
  targetMemberId String?
  targetGroupId String?
  versionId String?
  pageId String?
  contextGroupId String?
  kind TeachingRecordKind?
  body String
  context String @default("")
  observedAt DateTime?
  createdAt DateTime @default(now())
  requestId String @unique
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  targetMember CourseMember? @relation(fields: [targetMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)
  targetGroup Group? @relation("ObservationTargetGroup", fields: [targetGroupId, offeringId], references: [id, offeringId], onDelete: Restrict)
  contextGroup Group? @relation("ObservationContextGroup", fields: [contextGroupId, offeringId], references: [id, offeringId], onDelete: Restrict)
  page CourseSubpage? @relation(fields: [pageId, offeringId], references: [id, offeringId], onDelete: Restrict)
  version SubmissionVersion? @relation(fields: [versionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  revisions TeachingObservationRevision[]

  @@unique([id, offeringId])
  @@index([offeringId, targetMemberId, createdAt])
  @@index([offeringId, targetGroupId, createdAt])
  @@index([offeringId, pageId, createdAt])
  @@index([offeringId, contextGroupId, createdAt])
}

model TeachingObservationRevision {
  id String @id @default(cuid())
  offeringId String
  observationId String
  authorUserId String
  revision Int
  action TeachingObservationChange
  body String?
  context String?
  observedAt DateTime?
  reason String @default("")
  requestId String @unique
  createdAt DateTime @default(now())
  observation TeachingObservation @relation(fields: [observationId, offeringId], references: [id, offeringId], onDelete: Restrict)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([observationId, revision])
}

model TeachingFeedback {
  id String @id @default(cuid())
  offeringId String
  authorUserId String
  targetMemberId String?
  targetGroupId String?
  versionId String?
  body String
  context String @default("")
  createdAt DateTime @default(now())
  requestId String @unique
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  targetMember CourseMember? @relation(fields: [targetMemberId, offeringId], references: [id, offeringId], onDelete: Restrict)
  targetGroup Group? @relation(fields: [targetGroupId, offeringId], references: [id, offeringId], onDelete: Restrict)
  version SubmissionVersion? @relation(fields: [versionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  recipients TeachingFeedbackRecipient[]

  @@unique([id, offeringId])
  @@index([offeringId, targetMemberId, createdAt])
  @@index([offeringId, targetGroupId, createdAt])
}

model TeachingFeedbackRecipient {
  offeringId String
  feedbackId String
  memberId String
  feedback TeachingFeedback @relation(fields: [feedbackId, offeringId], references: [id, offeringId], onDelete: Restrict)
  member CourseMember @relation(fields: [memberId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@id([feedbackId, memberId])
  @@index([memberId, offeringId])
}
